{
  "uid": "mcp-gateway-overview",
  "title": "MCP Gateway \u2014 Overview",
  "tags": [
    "mcp-gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Sessions",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "sum(mcp_session_active_ratio)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request Rate",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "sum(rate(mcp_http_request_duration_milliseconds_count[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "100 * sum(rate(mcp_http_request_duration_milliseconds_count{http_status_class=~\"4xx|5xx\"}[5m])) / sum(rate(mcp_http_request_duration_milliseconds_count[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tool Call Rate",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "sum(rate(mcp_tool_duration_milliseconds_count[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Gateway HTTP (Control Plane / Data Plane)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Rate by Component",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "sum by (mcp_component) (rate(mcp_http_request_duration_milliseconds_count[5m]))",
          "legendFormat": "{{mcp_component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request Latency (p50 / p95 / p99)",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(mcp_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mcp_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests by Status Class",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "sum by (http_status_class) (rate(mcp_http_request_duration_milliseconds_count[5m]))",
          "legendFormat": "{{http_status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "MCP Tool Usage",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tool Call Rate by Server",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "sum by (mcp_server_name) (rate(mcp_tool_duration_milliseconds_count[5m]))",
          "legendFormat": "{{mcp_server_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tool Call p95 Latency by Server",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "histogram_quantile(0.95, sum by (le, mcp_server_name) (rate(mcp_tool_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{mcp_server_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Top Tools (last 1h, call count)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-gw-prometheus-uwm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mcp-gw-prometheus-uwm"
          },
          "expr": "topk(10, sum by (mcp_server_name, mcp_tool_name) (increase(mcp_tool_duration_milliseconds_count[1h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Gateway Logs",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Log Volume by Severity",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "mcp-gw-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "mcp-gw-loki"
          },
          "expr": "sum by (severity_text) (count_over_time({service_name=\"docker-mcp-gateway\"}[$__interval]))",
          "legendFormat": "{{severity_text}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Warnings & Errors",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "mcp-gw-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "mcp-gw-loki"
          },
          "expr": "{service_name=\"docker-mcp-gateway\"} | severity_text=~\"WARN|ERROR\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessages": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 17,
      "type": "logs",
      "title": "All Gateway Logs",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "mcp-gw-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "mcp-gw-loki"
          },
          "expr": "{service_name=\"docker-mcp-gateway\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessages": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
